/**
 * @file ak_tuya_authkey.h.example
 * @brief Template for the Tuya device license used by FP-3 tuya-cloud-asr.
 *
 * HOW TO USE (values are secrets - never commit the filled file):
 *   1. cp ak_tuya_authkey.h.example ak_tuya_authkey.h
 *   2. Fill AK_TUYA_UUID / AK_TUYA_AUTHKEY / AK_TUYA_PRODUCT_ID with the values
 *      from docs.local/tuya_keys.txt (gitignored).
 *
 * ak_tuya_authkey.h is gitignored (the .gitignore double-star authkey rule, plus
 * an explicit negation that keeps only this .example tracked). The real license
 * MUST NOT be committed. This .example holds placeholder values only.
 */

#ifndef AK_TUYA_AUTHKEY_H
#define AK_TUYA_AUTHKEY_H

/* Product ID (PID) created on the Tuya IoT platform. */
#define AK_TUYA_PRODUCT_ID "xxxxxxxxxxxxxxxx"

/* Device license - 20-char UUID + 32-char AuthKey (from docs.local/tuya_keys.txt). */
#define AK_TUYA_UUID    "uuidxxxxxxxxxxxxxxxx"
#define AK_TUYA_AUTHKEY "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

#endif /* AK_TUYA_AUTHKEY_H */
