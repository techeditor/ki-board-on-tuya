/**
 * @file ak_tuya_authkey.h.example
 * @brief Template for the Tuya device license used by the board-side cloud ASR
 *        (AK_ASR_BOARD_CLOUD=1 builds).
 *
 * HOW TO USE (values are secrets - never commit the filled file):
 *   1. cp ak_tuya_authkey.h.example ak_tuya_authkey.h
 *   2. Fill AK_TUYA_PRODUCT_ID with your PID (bound to a Tuya AI agent) and
 *      AK_TUYA_UUID / AK_TUYA_AUTHKEY with the device License.
 *
 * ak_tuya_authkey.h is gitignored (the repo-root .gitignore authkey glob rule,
 * with an explicit negation that keeps only this .example tracked). The real
 * license MUST NOT be committed. Alternatively, flash a License to the device
 * (tos.py auth / TyuTool) and tuya_authorize_read() supplies it at runtime; the
 * values here are then only the compile-time fallback.
 */

#ifndef AK_TUYA_AUTHKEY_H
#define AK_TUYA_AUTHKEY_H

/* Product ID (PID) created on the Tuya IoT platform and bound to an AI agent. */
#define AK_TUYA_PRODUCT_ID "xxxxxxxxxxxxxxxx"

/* Device license: 20-char UUID + 32-char AuthKey. */
#define AK_TUYA_UUID    "uuidxxxxxxxxxxxxxxxx"
#define AK_TUYA_AUTHKEY "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

#endif /* AK_TUYA_AUTHKEY_H */
