CONFIG_PROJECT_VERSION="0.1.0"
CONFIG_TUYA_PRODUCT_ID="raqcmxucdchre5ga"
CONFIG_BOARD_CHOICE_T5AI=y
CONFIG_BOARD_CHOICE_TUYA_T5AI_CORE=y
CONFIG_ENABLE_GPIO=y
CONFIG_ENABLE_UART=y
CONFIG_ENABLE_BLUETOOTH=y
CONFIG_ENABLE_SPI=y
CONFIG_ENABLE_DISPLAY=y
CONFIG_DISPLAY_NAME="ak_lcd"
CONFIG_DISPLAY_DEFAULT_BRIGHTNESS=100
CONFIG_ENABLE_LIBLVGL=y
CONFIG_ENABLE_AI_LANGUAGE_ENGLISH=y
CONFIG_ENABLE_MBEDTLS_SSL_MAX_CONTENT_LEN=4096
CONFIG_BUTTION_STACK_SIZE=4096
CONFIG_ENABLE_COMP_AI_MODE_HOLD=y
# The AI component ships its own LVGL chat UI that would drive the same ST7789
# the app renders via ak_statuslcd (direct, no LVGL) — two owners of one display
# = black/garbled screen. FP-3's known-good config disables it; do the same, and
# pin HOLD as the only AI mode (K4 push-to-talk drives capture directly).
# CONFIG_ENABLE_COMP_AI_DISPLAY is not set
# CONFIG_ENABLE_COMP_AI_MODE_ONESHOT is not set
# CONFIG_ENABLE_COMP_AI_MODE_WAKEUP is not set
# CONFIG_ENABLE_COMP_AI_MODE_FREE is not set
CONFIG_AK_TRANSPORT_DUAL=y
CONFIG_AK_ASR_BOARD_CLOUD=y
