# ===== Secrets / device license (NEVER commit) =====
# Tuya device license, ASR keys, provisioning credentials, env files.
*.pem
*.key
.env
.env.*
**/secrets/
**/*authkey*
**/*auth_key*
uuid_authkey*.txt
